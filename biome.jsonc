{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite"],
  "linter": {
    "rules": {
      "a11y": {
        "useButtonType": "off",
        "noSvgWithoutTitle": "off"
      },
      "nursery": {
        "useImageSize": "off"
      },
      "performance": {
        "noImgElement": "off"
      },
      "complexity": {
        "useLiteralKeys": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConsole": {
          "level": "warn",
          "options": {
            "allow": ["assert", "error", "info", "warn"]
          }
        }
      }
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "!apps/**/*.css",
      "!packages/**/*.css",
      "!template/**/*.css",
      "!packages/ui/**/*.{ts,tsx}",
      "!packages/cli/**/*.{ts,tsx}",
      "!packages/core/**/*.{ts,tsx}",
      "!packages/database/**/*.{ts,tsx}",
      "!packages/ui/**/*.{ts,tsx}",
      "!apps/web/database/**/*.{ts,tsx}",
      "!apps/web/app/api/linkb/**/*.{ts,tsx}"
    ]
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
